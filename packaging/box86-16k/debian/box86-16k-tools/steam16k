#!/bin/sh
set -eu

STEAM_RUNTIME_BIN=${STEAM_RUNTIME_BIN:-}
LOCAL_STEAM_SH="$HOME/.local/share/Steam/steam.sh"
SYSTEM_STEAM_BIN=/usr/bin/steam
SYSTEM_STEAM_GAMES=/usr/games/steam
NATIVE16K=/usr/lib/box86-16k/native16k

if [ -z "$STEAM_RUNTIME_BIN" ] || [ "$STEAM_RUNTIME_BIN" = /usr/bin/steam16k ]; then
    if [ -x "$LOCAL_STEAM_SH" ]; then
        STEAM_RUNTIME_BIN=$LOCAL_STEAM_SH
    elif [ -x "$SYSTEM_STEAM_BIN" ]; then
        STEAM_RUNTIME_BIN=$SYSTEM_STEAM_BIN
    elif [ -x "$SYSTEM_STEAM_GAMES" ]; then
        STEAM_RUNTIME_BIN=$SYSTEM_STEAM_GAMES
    else
        echo "Steam executable not found." >&2
        exit 1
    fi
fi

[ -x /usr/lib/box86-16k/bin/box86 ] || {
    echo "box86-16k runtime missing: /usr/lib/box86-16k/bin/box86" >&2
    exit 1
}

# Do not put ARMHF libraries into the environment of Steam's 64-bit bootstrap,
# runtime supervisor, or Box64 helpers. Mark the process tree instead; the
# /usr/bin/box86-16k binfmt interpreter applies these paths only when an i386
# executable is actually handed to Box86.
if [ -d "$NATIVE16K" ]; then
    export BOX86_NATIVE16K_DIR="$NATIVE16K"
    export BOX86_LIBGL=${BOX86_LIBGL:-$NATIVE16K/libGL.so.1}
fi

# Preserve BOX86_NORCFILES and BOX86_EMULATED_LIBS supplied by the caller.
export STEAM_RUNTIME=${STEAM_RUNTIME:-1}
export STEAMOS=${STEAMOS:-1}
export PATH="/usr/lib/box86-16k/bin:$PATH"
exec "$STEAM_RUNTIME_BIN" "$@"
