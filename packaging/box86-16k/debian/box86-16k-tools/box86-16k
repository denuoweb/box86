#!/bin/sh
set -eu

# steam16k marks its i386 descendants with BOX86_NATIVE16K_DIR instead of
# exporting ARMHF loader/graphics paths into Steam's 64-bit bootstrap and
# supervisor processes. Apply those paths only once binfmt hands an i386 ELF to
# this Box86 interpreter wrapper.
if [ -n "${BOX86_NATIVE16K_DIR:-}" ] && [ -d "$BOX86_NATIVE16K_DIR" ]; then
    NATIVE16K=$BOX86_NATIVE16K_DIR
    export LD_LIBRARY_PATH="$NATIVE16K${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

    if [ -d "$NATIVE16K/dri" ]; then
        export LIBGL_DRIVERS_PATH="$NATIVE16K/dri${LIBGL_DRIVERS_PATH:+:$LIBGL_DRIVERS_PATH}"
    fi

    if [ -d "$NATIVE16K/egl_vendor.d" ]; then
        export __EGL_VENDOR_LIBRARY_DIRS="$NATIVE16K/egl_vendor.d${__EGL_VENDOR_LIBRARY_DIRS:+:$__EGL_VENDOR_LIBRARY_DIRS}"
    fi

    if [ -z "${VK_ICD_FILENAMES:-}" ] && [ -d "$NATIVE16K/vulkan/icd.d" ]; then
        vk_icds=
        for f in "$NATIVE16K"/vulkan/icd.d/*.json; do
            [ -f "$f" ] || continue
            vk_icds="${vk_icds:+$vk_icds:}$f"
        done
        [ -z "$vk_icds" ] || export VK_ICD_FILENAMES="$vk_icds"
    fi

    export BOX86_LIBGL=${BOX86_LIBGL:-$NATIVE16K/libGL.so.1}
fi

exec /usr/lib/box86-16k/bin/box86 "$@"
