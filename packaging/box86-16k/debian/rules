#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --builddirectory=debian/build -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DRPI4ARM64=1 \
		-DARM_DYNAREC=1 \
		-DNOGIT=1 \
		-DNO_LIB_INSTALL=1 \
		-DNO_CONF_INSTALL=1 \
		-DCMAKE_C_COMPILER=arm-linux-gnueabihf-gcc \
		-DCMAKE_ASM_COMPILER=arm-linux-gnueabihf-gcc

override_dh_auto_build:
	dh_auto_build --builddirectory=debian/build

override_dh_auto_test:
	python3 tests/box86-16k/test_mapping_model.py
	python3 tests/box86-16k/make_elf32_16k_fixture.py debian/build/elf32-16k-overlap
	readelf -l debian/build/elf32-16k-overlap | grep -q 'LOAD'

override_dh_auto_install:
	install -Dm755 debian/build/box86 debian/box86-16k/usr/lib/box86-16k/bin/box86
	install -Dm755 debian/box86-16k-tools/box86-16k debian/box86-16k/usr/bin/box86-16k
	install -Dm755 debian/box86-16k-tools/steam16k debian/box86-16k/usr/bin/steam16k
	install -Dm755 debian/box86-16k-tools/box86-16k-status debian/box86-16k/usr/bin/box86-16k-status
	install -Dm644 debian/box86-16k-tools/box86-binfmt.conf debian/box86-16k/etc/binfmt.d/box86.conf
	# Keep NO_CONF_INSTALL for a private runtime layout, but install Box86's
	# standard rc database explicitly. Steam depends on its [steam] profile
	# (BOX86_NOGTK, strongmem, callret and emulated-library overrides).
	install -Dm644 system/box86.box86rc debian/box86-16k/etc/box86.box86rc
	install -Dm755 tests/box86-16k/test_16k_elfloader.sh debian/box86-16k/usr/lib/box86-16k/tests/test_16k_elfloader.sh
	install -Dm755 tests/box86-16k/test_steam_16k.sh debian/box86-16k/usr/lib/box86-16k/tests/test_steam_16k.sh
	install -Dm755 tests/box86-16k/test_mapping_model.py debian/box86-16k/usr/lib/box86-16k/tests/test_mapping_model.py
	install -Dm755 tests/box86-16k/make_elf32_16k_fixture.py debian/box86-16k/usr/lib/box86-16k/tests/make_elf32_16k_fixture.py
	install -Dm755 scripts/armhf16k-audit.py debian/box86-16k/usr/lib/box86-16k/tools/armhf16k-audit.py
	install -Dm644 armhf16k/manifest.tsv debian/box86-16k/usr/share/box86-16k/armhf16k-manifest.tsv
	install -Dm644 armhf16k/baseline-debian13-pi5.tsv debian/box86-16k/usr/share/box86-16k/armhf16k-baseline-debian13-pi5.tsv

override_dh_shlibdeps:
	dh_shlibdeps --exclude=libgcc_s.so.1 --exclude=libpng12.so.0 --exclude=libstdc++.so.5 --exclude=libstdc++.so.6 --exclude=libunwind.so.8
