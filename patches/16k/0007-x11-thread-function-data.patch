From: box86-16k contributors
Subject: [PATCH 7/7] X11: bridge thread function-pointer globals

XInitThreads populates exported libX11 data symbols with native function
pointers. Because wrapped libX11 is native, an emulated i386 caller can read
one of those DATAB globals and branch to an ARM/Thumb address as though it
were x86 code.

Keep the real libX11 data objects exposed so reads and writes preserve Xlib's
data ABI. Register automatic bridges for all seven function pointers that
XInitThreads initializes, so their native addresses resolve to x86 bridge
thunks when used as code.

Refresh the mappings after a guest XInitThreads call and during wrapper
initialization. The latter covers both BOX86_X11THREADS and libX11 builds
that initialize threading from a constructor.
---
 src/wrapped/wrappedlibx11.c         | 34 +++++++++++++++++++++++++++++-----
 src/wrapped/wrappedlibx11_private.h |  2 +-
 2 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/src/wrapped/wrappedlibx11.c b/src/wrapped/wrappedlibx11.c
--- a/src/wrapped/wrappedlibx11.c
+++ b/src/wrapped/wrappedlibx11.c
@@ -83,18 +83,40 @@
 } XImage;
 
 typedef void (*vFp_t)(void*);
-typedef uint32_t (*uFv_t)(void);
 typedef int32_t (*iFpl_t)(void*, intptr_t);
 typedef uintptr_t (*LFpii_t)(void*, int32_t, int32_t);
 typedef int32_t (*iFpiiL_t)(void*, int32_t, int32_t, uintptr_t);
 typedef void* (*pFpiiuu_t)(void*, int32_t, int32_t, uint32_t, uint32_t);
 
-#define ADDED_FUNCTIONS()   \
-    GO(XInitThreads, uFv_t) \
+static void bridgeX11ThreadFunction(x86emu_t* emu, library_t* lib, const char* name, wrapper_t w)
+{
+    void** slot = (void**)dlsym(lib->w.lib, name);
+    if(slot && *slot)
+        AddAutomaticBridge(emu, lib->w.bridge, w, *slot, 0, name);
+}
+
+static void bridgeX11ThreadFunctions(x86emu_t* emu, library_t* lib)
+{
+    bridgeX11ThreadFunction(emu, lib, "_XCreateMutex_fn", vFp);
+    bridgeX11ThreadFunction(emu, lib, "_XFreeMutex_fn", vFp);
+    bridgeX11ThreadFunction(emu, lib, "_XLockMutex_fn", vFp);
+    bridgeX11ThreadFunction(emu, lib, "_XUnlockMutex_fn", vFp);
+    bridgeX11ThreadFunction(emu, lib, "_XInitDisplayLock_fn", iFp);
+    bridgeX11ThreadFunction(emu, lib, "_XFreeDisplayLock_fn", vFp);
+    bridgeX11ThreadFunction(emu, lib, "_Xthread_self_fn", uFv);
+}
 
 #include "generated/wrappedlibx11types.h"
 
 #include "wrappercallback.h"
+
+EXPORT int my_XInitThreads(x86emu_t* emu)
+{
+    int ret = my->XInitThreads();
+    if(ret)
+        bridgeX11ThreadFunctions(emu, my_lib);
+    return ret;
+}
 
 #define SUPER() \
 GO(0)   \
@@ -1603,12 +1625,14 @@
     #define CUSTOM_INIT                 \
         getMy(lib);                     \
         setNeededLibs(lib, 1, "libdl.so"); \
-        if(box86_x11threads) my->XInitThreads();
+        if(box86_x11threads) my->XInitThreads(); \
+        bridgeX11ThreadFunctions(thread_get_emu(), lib);
 #else
     #define CUSTOM_INIT                 \
         getMy(lib);                     \
         setNeededLibs(lib, 1, "libdl.so.2"); \
-        if(box86_x11threads) my->XInitThreads();
+        if(box86_x11threads) my->XInitThreads(); \
+        bridgeX11ThreadFunctions(thread_get_emu(), lib);
 #endif
 
 #define CUSTOM_FINI \
diff --git a/src/wrapped/wrappedlibx11_private.h b/src/wrapped/wrappedlibx11_private.h
--- a/src/wrapped/wrappedlibx11_private.h
+++ b/src/wrapped/wrappedlibx11_private.h
@@ -488,7 +488,7 @@
 GOM(XInitImage, iFEp)
 // _XInitImageFuncPtrs
 // _XInitKeysymDB
-GO(XInitThreads, uFv)
+GOM(XInitThreads, iFEv)
 //GO(XInsertModifiermapEntry
 GO(XInstallColormap, iFpp)
 GO(XInternalConnectionNumbers, iFppp)
