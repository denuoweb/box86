 typedef struct blocklist_s {
     void*               block;
@@ -1045,11 +1046,52 @@ int getMmapped(uintptr_t addr)
     return rb_get(mmapmem, addr);
 }
 
+int memExist(uintptr_t addr)
+{
+    return rb_get(mapallmem, addr);
+}
+
+void setFileMapped(uintptr_t addr, size_t size)
+{
+    if(!size)
+        return;
+    addr &= ~(box86_pagesize-1);
+    size = ALIGN(size);
+    mutex_lock(&mutex_prot);
+    rb_set(mmapfilemem, addr, addr+size, 1);
+    mutex_unlock(&mutex_prot);
+}
+
+void clearFileMapped(uintptr_t addr, size_t size)
+{
+    if(!size)
+        return;
+    uintptr_t start = addr & ~(box86_pagesize-1);
+    uintptr_t end = ALIGN(addr + size);
+    if(end < start)
+        return;
+    mutex_lock(&mutex_prot);
+    rb_unset(mmapfilemem, start, end);
+    mutex_unlock(&mutex_prot);
+}
+
+int getFileMapped(uintptr_t addr)
+{
+    return rb_get(mmapfilemem, addr);
+}
