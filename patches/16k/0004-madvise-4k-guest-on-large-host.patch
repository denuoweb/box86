diff --git a/src/custommem.c b/src/custommem.c
index a8cdfd1..16c0004 100644
--- a/src/custommem.c
+++ b/src/custommem.c
@@ -55,6 +55,7 @@ static int inited = 0;
 
 static rbtree*  mapallmem = NULL;
 static rbtree*  mmapmem = NULL;
