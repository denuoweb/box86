+
+EXPORT int my_madvise(x86emu_t* emu, void* addr, size_t length, int advice)
+{
+    (void)emu;
+    uintptr_t start = (uintptr_t)addr;
+
+    /* Linux/i386 validates alignment against the guest's 4K page size. */
+    if(start & (BOX86_X86_PAGE_SIZE - 1)) {
+        errno = EINVAL;
+        return -1;
+    }
+    if(!length)
+        return 0;
+
+    uintptr_t end = start + length;
+    if(end < start) {
+        errno = ENOMEM;
+        return -1;
+    }
+    end = (end + BOX86_X86_PAGE_SIZE - 1) & ~(BOX86_X86_PAGE_SIZE - 1);
+    if(end < start) {
+        errno = ENOMEM;
+        return -1;
+    }
+
+    if(box86_pagesize == BOX86_X86_PAGE_SIZE)
+        return madvise((void*)start, end-start, advice);
+
+    uintptr_t host_start = start & ~(box86_pagesize - 1);
+    uintptr_t host_end = (end + box86_pagesize - 1) & ~(box86_pagesize - 1);
+    if(host_end < end) {
+        errno = ENOMEM;
+        return -1;
+    }
+
+    /* Non-discard advice can safely use the containing host pages. */
+    if(advice != MADV_DONTNEED)
+        return madvise((void*)host_start, host_end-host_start, advice);
+
+    /* A host-aligned discard can use the real syscall directly. */
+    if(start == host_start && end == host_end)
+        return madvise((void*)start, end-start, advice);
+
+    /*
+     * MADV_DONTNEED is destructive.  On a partial host page, discarding the
+     * whole host page would also discard neighbouring 4K guest pages.  Match
+     * Box64's non-4K fallback by zeroing only anonymous writable mmap pages.
+     * File-backed and non-mmap regions are left unchanged rather than
+     * corrupting data outside the guest request.
+     */
+    for(uintptr_t p = start; p < end; p += BOX86_X86_PAGE_SIZE) {
+        if(!memExist(p)) {
+            errno = ENOMEM;
+            return -1;
+        }
+        if(!getMmapped(p) || getFileMapped(p))
+            return 0;
+        if(!(getProtection(p) & PROT_WRITE))
+            return 0;
+    }
+    memset((void*)start, 0, end-start);
+    return 0;
+}
+
+EXPORT int my___madvise(x86emu_t* emu, void* addr, size_t length, int advice) __attribute__((alias("my_madvise")));
+
+EXPORT int my_posix_madvise(x86emu_t* emu, void* addr, size_t length, int advice)
+{
+    (void)emu;
+    if(advice == POSIX_MADV_DONTNEED)
+        return 0;
+    return posix_madvise(addr, length, advice);
+}
 
